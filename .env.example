# wg-messaging backend URL (defaults to http://localhost:4800 in development)
WG_MESSAGING_URL=http://localhost:4800

# Control plane API key for authenticating with wg-messaging backend
WG_API_KEY=local_development_key

# Gateway port
PORT=3001

# Optional timeout for backend requests in milliseconds (default 15000)
BACKEND_TIMEOUT_MS=15000
